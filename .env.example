# ==============================================================================
# 1. CORE DJANGO SETTINGS
# ==============================================================================
DEBUG=True
DJANGO_SECRET_KEY=abcdefghijklmnopqrstuvwxyz
DJANGO_SETTINGS_MODULE=settings.development

# ==============================================================================
# 2. PROJECT METADATA & FEATURE FLAGS
# ==============================================================================
NAMESPACE=local
SERVICE_NAME=SAMSR-BACKEND
SERVICE_VERSION=1.0.0

ENABLE_DOCS=False
ENABLE_EMAIL=False
ENABLE_HEALTHCHECKS=True
ENABLE_METRICS=False
ENABLE_SILK=False
ENABLE_TRACING=False

# ==============================================================================
# 3. DATABASE & CACHE/BROKER
# ==============================================================================
# Postgres
POSTGRES_DB_HOST=127.0.0.1
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=samsr
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=postgres
POSTGRES_DB_SSL_ENABLED=False

# Message Broker (RabbitMQ)
BROKER_ENGINE=rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=samsr-queue

# ==============================================================================
# 4. STORAGE & INFRASTRUCTURE
# ==============================================================================
# AWS S3 / MinIO
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_BUCKET=samsr
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_USE_SSL=False

# ==============================================================================
# 5. SECURITY & AUTHENTICATION
# ==============================================================================
ACCESS_TOKEN_LIFETIME_IN_MINUTES=15
REFRESH_TOKEN_LIFETIME_IN_MINUTES=10080

# Google OAuth
GOOGLE_CLIENT_ID=1234-abcd.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=secret

# ==============================================================================
# 6. EXTERNAL SERVICES & COMMUNICATION
# ==============================================================================
# Email (SMTP / AWS_SES / SENDGRID)
EMAIL_PROVIDER=SMTP
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=support@vetostudios.com
EMAIL_HOST_PASSWORD=password
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# Third-party Tools
TAVILY_API_KEY=your-tavily-api-key

# ==============================================================================
# 7. AI & LLM PROVIDERS
# ==============================================================================
# Main LLM Config
LLM_PROVIDER=AWS_BEDROCK_NATIVE

# AWS Bedrock Profiles & Providers
AWS_BEDROCK_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=your-absk-key

AWS_BEDROCK_MODEL_PROVIDER=anthropic
AWS_BEDROCK_INFERENCE_PROFILE_ID=

AWS_BEDROCK_INTENT_CLASSIFIER_MODEL_PROVIDER=amazon
AWS_BEDROCK_INTENT_CLASSIFIER_INFERENCE_PROFILE_ID=

AWS_BEDROCK_TITLE_MODEL_PROVIDER=meta
AWS_BEDROCK_TITLE_INFERENCE_PROFILE_ID=

AWS_BEDROCK_CHAT_MODEL_PROVIDER=anthropic
AWS_BEDROCK_CHAT_INFERENCE_PROFILE_ID=

# ==============================================================================
# 8. VECTOR DATABASE & EMBEDDINGS (DOCUSAFE)
# ==============================================================================
# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=docusafe_files
QDRANT_API_KEY=
QDRANT_URL=

# AWS Embeddings
EMBEDDING_PROVIDER=AWS_BEDROCK

AWS_BEDROCK_EMBEDDING_REGION=us-east-1
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AWS_BEDROCK_EMBEDDING_DIMENSIONS=1024

AWS_BEDROCK_EMBEDDING_ACCESS_KEY_ID=
AWS_BEDROCK_EMBEDDING_SECRET_ACCESS_KEY=
AWS_BEDROCK_EMBEDDING_TEXTRACT_REGION=ap-south-1

# ==============================================================================
# 9. OBSERVABILITY & DEPLOYMENT
# ==============================================================================
# Metrics & OTEL
OTEL_GRPC_ENDPOINT=localhost:4317

# LangSmith Monitoring
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT="SamsR"

# Gunicorn & Network
HTTP_PORT=8000
WEB_SOCKET_PORT=8001
GUNICORN_WORKERS=2
GUNICORN_THREADS_PER_WORKER=8
DEPLOYMENT_MODE=FULL

# Docker Image Info
# DOCKER_IMAGE_REPO="docker-image-repo"     # Added automatically in CICD
# DOCKER_IMAGE_TAG="docker-image-tag"       # Added automatically in CICD

PROJECT_ROOT_DIR=/project
