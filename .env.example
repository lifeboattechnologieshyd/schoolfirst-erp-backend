# ==============================================================================
# 1. CORE DJANGO SETTINGS
# ==============================================================================
DEBUG=True
DJANGO_SECRET_KEY=abcdefghijklmnopqrstuvwxyz
DJANGO_SETTINGS_MODULE=settings.development

# ==============================================================================
# 2. PROJECT METADATA & FEATURE FLAGS
# ==============================================================================
NAMESPACE=local
SERVICE_NAME=SCHOOLFIRST-ERP-BACKEND
SERVICE_VERSION=1.0.0

ENABLE_DOCS=False
ENABLE_EMAIL=False
ENABLE_HEALTHCHECKS=True
ENABLE_METRICS=False
ENABLE_SILK=False
ENABLE_TRACING=False

# ==============================================================================
# 3. DATABASE & CACHE/BROKER
# ==============================================================================
# Postgres
POSTGRES_DB_HOST=127.0.0.1
POSTGRES_DB_PORT=5432
POSTGRES_DB_NAME=schoolfirst-erp
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=postgres
POSTGRES_DB_SSL_ENABLED=False

# ==============================================================================
# 4. STORAGE & INFRASTRUCTURE
# ==============================================================================
# AWS S3 / MinIO
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_BUCKET=schoolfirst-erp
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_USE_SSL=False

# ==============================================================================
# 5. SECURITY & AUTHENTICATION
# ==============================================================================
ACCESS_TOKEN_LIFETIME_IN_MINUTES=15
REFRESH_TOKEN_LIFETIME_IN_MINUTES=10080

# ==============================================================================
# 6. EXTERNAL SERVICES & COMMUNICATION
# ==============================================================================
# Email (SMTP / AWS_SES / SENDGRID)
EMAIL_PROVIDER=SMTP
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_HOST_USER=support@schoolfirst.ai
EMAIL_HOST_PASSWORD=password
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# ==============================================================================
# 9. OBSERVABILITY & DEPLOYMENT
# ==============================================================================
# Metrics & OTEL
OTEL_GRPC_ENDPOINT=localhost:4317

# Gunicorn & Network
HTTP_PORT=8000
WEB_SOCKET_PORT=8001
GUNICORN_WORKERS=2
GUNICORN_THREADS_PER_WORKER=8
DEPLOYMENT_MODE=FULL

PROJECT_ROOT_DIR=/project
