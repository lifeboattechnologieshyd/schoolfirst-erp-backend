{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: Run Server",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "runserver",
                "0.0.0.0:8000"
            ],
            "django": true,
            "justMyCode": false,
            "autoStartBrowser": false,
        },
        {
            "name": "Django: Migrations",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "makemigrations"
            ],
            "django": true,
            "justMyCode": false,
            "env": {
                "DJANGO_ENV": "development",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "presentation": {
                "hidden": false,
                "group": "Django",
                "order": 2
            }
        },
        {
            "name": "Django: Shell",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "shell"
            ],
            "django": true,
            "justMyCode": false,
            "console": "integratedTerminal",
            "env": {
                "DJANGO_ENV": "development",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "presentation": {
                "hidden": false,
                "group": "Django",
                "order": 4
            }
        },
        {
            "name": "Django: Management Command",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": [
                "${input:command}",
                "${input:commandArgs}"
            ],
            "django": true,
            "justMyCode": false,
            "env": {
                "DJANGO_ENV": "development",
                "PYTHONPATH": "${workspaceFolder}"
            },
            "presentation": {
                "hidden": false,
                "group": "Django",
                "order": 6
            }
        }
    ],
    "inputs": [
        {
            "id": "command",
            "type": "promptString",
            "description": "Django management command to run",
            "default": "help"
        },
        {
            "id": "commandArgs",
            "type": "promptString",
            "description": "Arguments for the command",
            "default": ""
        }
    ]
}
