{
    // Ruff configuration
    "ruff.enable": true,
    "ruff.organizeImports": true,
    "ruff.fixAll": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.indentSize": "tabSize",
    // Files settings
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/*.pyc": true
    },
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.associations": {
        "**/requirements/*.txt": "pip-requirements"
    },
    // Django specific settings
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "editor.inlayHints.enabled": "off",
    "cursorpyright.analysis.autoImportCompletions": true,
    "cursorpyright.analysis.autoSearchPaths": true,
    "cursorpyright.analysis.diagnosticMode": "workspace",
    "cursorpyright.analysis.extraPaths": [
        "${workspaceFolder}"
    ],
    "cursorpyright.analysis.typeCheckingMode": "basic",
    "python.defaultInterpreterPath": ".venv/bin/python",
    "ty.importStrategy": "fromEnvironment",
    "ty.interpreter": "${workspaceFolder}/.venv/bin/python",
    "ty.configuration": {
        "environment": {
            "python": "./.venv"
        }
    },
    "chat.tools.terminal.autoApprove": {}
}
