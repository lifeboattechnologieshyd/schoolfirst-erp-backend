local.file_match "schoolfirst_logs" {
  path_targets = [{
    __path__ = "/project/logs/*.log",
  }]
}

loki.source.file "schoolfirst_logs" {
  targets    = local.file_match.schoolfirst_logs.targets
  forward_to = [loki.process.schoolfirst_logs.receiver]
}

loki.process "schoolfirst_logs" {

  stage.json {
    expressions = {
      level      = "level",
      event      = "event",
      timestamp  = "timestamp",
      request_id = "request_id",
      trace_id   = "trace_id",
      module     = "module",
    }
  }

  stage.labels {
    values = {
      level = "level",
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {

  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }

  external_labels = {
    application = "schoolfirst-erp",
    environment = "development",
  }
}